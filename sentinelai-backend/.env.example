# =============================================================================
# SentinelAI - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control
# =============================================================================

# Application
PROJECT_NAME=SentinelAI
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-256-bit-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12
MFA_ENABLED=false
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=sentinelai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
DATABASE_SSL_ENABLED=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
AI_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=60

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=sentinelai@example.com
EMAILS_FROM_NAME=SentinelAI

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
PROMETHEUS_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_AUTH=5/minute

# Elasticsearch (optional)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=sentinelai

# SIEM Configuration
SIEM_EVENT_BATCH_SIZE=1000
SIEM_MAX_EVENTS_PER_SECOND=100000
SIEM_RETENTION_DAYS=90

# File Upload
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.log,.txt,.csv,.json,.xml,.evtx,.pcap,.dmp,.zip,.gz

# WebSocket
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL=30
