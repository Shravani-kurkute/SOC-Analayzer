# =============================================================================
# SentinelAI - Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control
# =============================================================================

# Application
VITE_APP_NAME=SentinelAI
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_TOKEN_KEY=sentinelai_auth_token
VITE_AUTH_REFRESH_KEY=sentinelai_refresh_token
VITE_SESSION_TIMEOUT_MINUTES=60

# AI Configuration
VITE_AI_ENABLED=true
VITE_AI_WEBSOCKET_URL=ws://localhost:8000/ws/ai

# Monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Feature Flags
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_PLAYBOOKS=true
VITE_FEATURE_ADVANCED_ANALYTICS=true
VITE_FEATURE_MFA=false
VITE_FEATURE_THREAT_INTEL=true
VITE_FEATURE_AUTO_RESPONSE=true

# UI Configuration
VITE_DEFAULT_THEME=dark
VITE_SIDEBAR_COLLAPSED=false
VITE_REFRESH_INTERVAL=30000
VITE_NOTIFICATIONS_ENABLED=true
VITE_MAX_LOG_ENTRIES=1000

# Pagination
VITE_DEFAULT_PAGE_SIZE=25
VITE_MAX_PAGE_SIZE=100

# Charts
VITE_CHART_ANIMATION_DURATION=500
VITE_REALTIME_UPDATE_INTERVAL=5000
