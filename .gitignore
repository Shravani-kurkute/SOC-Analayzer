# =============================================================================
# SentinelAI - .gitignore
# =============================================================================

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Build outputs
**/dist/
**/build/
**/*.tsbuildinfo

# Environment files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
**/venv/
**/.venv/
**/env/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.cache/
*.egg-info/
.eggs/
dist/
build/
*.egg
*.whl
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.pytest_cache/

# Logs
**/logs/
*.log
*.log.*

# Frontend log collection page
!sentinelai-frontend/src/pages/logs/

# Docker
.docker/

# Uploads
uploads/
!infra/docker/postgres/init.sql

# Rules
rules/

# Reports
reports/generated/
reports/temp/

# Secrets
**/secrets/
**/credentials/
**/*.key
**/*.pem
**/*.cert

# Database
*.db
*.sqlite
*.sqlite3

# Testing
**/coverage/
.tox/
.cache/
test-results/
junit/
